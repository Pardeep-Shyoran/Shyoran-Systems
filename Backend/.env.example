# ==============================================================================
# SHYORAN SYSTEMS — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Keep this file secure and NEVER commit the actual .env file to public version control.

# Server Port & Frontend Origin
PORT=5001
FRONTEND_URL=http://localhost:5173

# Recipient Email (where project inquiries will be delivered)
CONTACT_TO_EMAIL=hello@pardeep-shyoran.me

# ==============================================================================
# SMTP EMAIL DELIVERY SETTINGS
# ==============================================================================
# If left blank, the server operates in safe DEV SIMULATION mode (logs delivery
# headers safely without sending, perfect for testing and UI development).

# Example 1: Custom Domain SMTP (e.g., mail.yourdomain.com, Zoho, Fastmail)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@pardeep-shyoran.me
# SMTP_PASS=your-secure-smtp-password
# SMTP_FROM=hello@pardeep-shyoran.me

# Example 2: Brevo / Sendinblue (Free tier: 300 emails/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login@domain.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=hello@pardeep-shyoran.me

# Example 3: Gmail (Requires 2-Factor Authentication & an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
